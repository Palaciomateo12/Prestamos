<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Solicita tu Préstamo - Portal del Cliente</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- SDK oficial de Supabase -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col justify-between">

  <header class="bg-indigo-600 text-white shadow-md py-4">
    <div class="max-w-4xl mx-auto px-4 flex justify-between items-center">
      <div class="flex items-center gap-2">
        <svg class="w-6 h-6 text-indigo-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <h1 class="text-xl font-bold tracking-tight">PrestamosApp</h1>
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-4 my-8 w-full space-y-8">
    <!-- SIMULADOR -->
    <section class="bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-slate-200">
      <div class="border-b border-slate-100 pb-4 mb-6">
        <h2 class="text-2xl font-extrabold text-slate-900">Simulá tu Préstamo al Instante</h2>
        <p class="text-slate-500 text-sm mt-1">Ingresá el monto y seleccioná las cuotas para conocer el costo exacto.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="space-y-5">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Monto a requerir ($)</label>
            <input type="number" id="montoInput" value="50000" min="5000" max="500000" step="5000" class="w-full p-3.5 bg-slate-50 border border-slate-300 rounded-xl font-semibold text-slate-800 text-lg focus:ring-2 focus:ring-indigo-500 focus:bg-white focus:outline-none transition-all">
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Plazo en Cuotas</label>
            <select id="cuotasSelect" class="w-full p-3.5 bg-slate-50 border border-slate-300 rounded-xl font-semibold text-slate-800 focus:ring-2 focus:ring-indigo-500 focus:bg-white focus:outline-none transition-all">
              <option value="1">1 cuota mensual</option>
              <option value="3" selected>3 cuotas mensuales</option>
              <option value="6">6 cuotas mensuales</option>
              <option value="12">12 cuotas mensuales</option>
            </select>
          </div>
        </div>

        <div class="bg-indigo-900 text-white p-6 rounded-xl flex flex-col justify-between space-y-4 shadow-lg relative overflow-hidden">
          <div>
            <span class="text-xs uppercase font-bold text-indigo-300 tracking-wider">Resumen del Cálculo</span>
            <div class="mt-4 space-y-3 text-sm">
              <div class="flex justify-between items-center text-indigo-200">
                <span>Interés Aplicado:</span>
                <span id="interesPorcentaje" class="font-bold text-white text-base">15%</span>
              </div>
              <div class="flex justify-between items-center text-indigo-200">
                <span>Valor por Cuota:</span>
                <span id="montoCuota" class="font-bold text-white text-base">$19,167</span>
              </div>
              <hr class="border-indigo-800">
              <div class="flex justify-between items-baseline pt-1">
                <span class="text-indigo-200 font-medium">Total a Devolver:</span>
                <span id="totalDevolver" class="text-2xl font-extrabold text-emerald-400">$57,500</span>
              </div>
            </div>
          </div>
          <button onclick="mostrarFormularioSolicitud()" class="w-full bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-bold py-3.5 rounded-xl transition-all shadow-md active:scale-95">
            Solicitar Préstamo Ahora
          </button>
        </div>
      </div>

      <!-- Formulario Solicitante -->
      <form id="formSolicitud" onsubmit="confirmarSolicitud(event)" class="hidden mt-8 pt-6 border-t border-slate-200 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold mb-1 text-slate-700">DNI / Documento</label>
            <input type="text" id="dniInput" required placeholder="Ej: 38123456" class="w-full p-3 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
          </div>
          <div>
            <label class="block text-xs font-semibold mb-1 text-slate-700">Teléfono (WhatsApp)</label>
            <input type="tel" id="telInput" required placeholder="Ej: +54 9 351 1234567" class="w-full p-3 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
          </div>
          <div>
            <label class="block text-xs font-semibold mb-1 text-slate-700">Correo Electrónico</label>
            <input type="email" id="emailInput" required placeholder="ejemplo@gmail.com" class="w-full p-3 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
          </div>
        </div>
        <div class="flex justify-end gap-3">
          <button type="button" onclick="ocultarFormularioSolicitud()" class="px-5 py-2.5 bg-slate-200 hover:bg-slate-300 text-slate-700 text-sm font-semibold rounded-lg">Cancelar</button>
          <button type="submit" id="btnEnviar" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg text-sm shadow">
            Confirmar y Enviar Solicitud
          </button>
        </div>
      </form>
    </section>

    <!-- PANEL DEL CLIENTE -->
    <section id="panelCliente" class="hidden bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-slate-200 space-y-6">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 border-b border-slate-100 pb-4">
        <div>
          <h2 class="text-xl font-bold text-slate-900">Estado de tu Préstamo</h2>
          <p id="clienteIdentificador" class="text-xs text-slate-500 font-mono mt-0.5"></p>
        </div>
        <span id="clienteEstadoBadge" class="bg-amber-100 text-amber-800 text-xs font-bold px-3 py-1.5 rounded-full border border-amber-200">
          Pendiente de Aprobación
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200/80">
          <p class="text-xs text-slate-400 font-bold uppercase tracking-wider">Monto Solicitado</p>
          <p id="panelSolicitado" class="text-xl font-black text-slate-800 mt-1">$0</p>
        </div>
        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200/80">
          <p class="text-xs text-slate-400 font-bold uppercase tracking-wider">Llevás Devuelto</p>
          <p id="panelDevuelto" class="text-xl font-black text-emerald-600 mt-1">$0</p>
        </div>
        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200/80">
          <p class="text-xs text-slate-400 font-bold uppercase tracking-wider">Cuotas Abonadas</p>
          <p id="panelCuotasFalta" class="text-xl font-black text-indigo-600 mt-1">0 / 0</p>
        </div>
      </div>
    </section>
  </main>

  <script>
    // CONFIGURACIÓN DE SUPABASE (Reemplaza con tus datos reales)
    const SUPABASE_URL = 'https://ndetpdwwiemjgqarnvoi.supabase.co';
    const SUPABASE_ANON_KEY = 'sb_publishable_oq80v6WGHQ1Vh38NffoXQA_W7J4dB7S';
    const supabase = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    const montoInput = document.getElementById('montoInput');
    const cuotasSelect = document.getElementById('cuotasSelect');

    function calcularPrestamo() {
      const monto = parseFloat(montoInput.value) || 0;
      const cuotas = parseInt(cuotasSelect.value);
      let tasaBase = cuotas === 1 ? 5 : cuotas === 3 ? 15 : cuotas === 6 ? 35 : 70;
      if (monto > 100000) tasaBase += 5;

      const totalDevolver = monto + (monto * (tasaBase / 100));
      const valorCuota = totalDevolver / cuotas;

      document.getElementById('interesPorcentaje').innerText = `${tasaBase}%`;
      document.getElementById('montoCuota').innerText = `$${valorCuota.toLocaleString('es-AR', {maximumFractionDigits: 0})}`;
      document.getElementById('totalDevolver').innerText = `$${totalDevolver.toLocaleString('es-AR', {maximumFractionDigits: 0})}`;

      return { monto, cuotas, tasaBase, totalDevolver, valorCuota };
    }

    montoInput.addEventListener('input', calcularPrestamo);
    cuotasSelect.addEventListener('change', calcularPrestamo);

    function mostrarFormularioSolicitud() { document.getElementById('formSolicitud').classList.remove('hidden'); }
    function ocultarFormularioSolicitud() { document.getElementById('formSolicitud').classList.add('hidden'); }

    async function confirmarSolicitud(event) {
      event.preventDefault();
      const btn = document.getElementById('btnEnviar');
      btn.disabled = true;
      btn.innerText = "Guardando...";

      const calc = calcularPrestamo();
      const nuevoPrestamo = {
        dni: document.getElementById('dniInput').value,
        tel: document.getElementById('telInput').value,
        email: document.getElementById('emailInput').value,
        monto: calc.monto,
        interes: calc.tasaBase,
        total_devolver: calc.totalDevolver,
        monto_devuelto: 0,
        cuotas_totales: calc.cuotas,
        cuotas_pagadas: 0,
        estado: "Pendiente"
      };

      // Guardar en la base de datos Supabase
      const { data, error } = await supabase.from('prestamos').insert([nuevoPrestamo]).select();

      btn.disabled = false;
      btn.innerText = "Confirmar y Enviar Solicitud";

      if (error) {
        alert('Error al guardar la solicitud: ' + error.message);
        return;
      }

      alert('¡Solicitud guardada en el servidor con éxito!');
      ocultarFormularioSolicitud();
      renderizarPanelCliente(data[0]);
    }

    function renderizarPanelCliente(p) {
      document.getElementById('panelCliente').classList.remove('hidden');
      document.getElementById('clienteIdentificador').innerText = `DNI: ${p.dni} | Email: ${p.email}`;
      document.getElementById('panelSolicitado').innerText = `$${p.monto.toLocaleString('es-AR')}`;
      document.getElementById('panelDevuelto').innerText = `$${Math.round(p.monto_devuelto).toLocaleString('es-AR')}`;
      document.getElementById('panelCuotasFalta').innerText = `${p.cuotas_pagadas} de ${p.cuotas_totales}`;
      document.getElementById('clienteEstadoBadge').innerText = p.estado;
    }

    calcularPrestamo();
  </script>
</body>
</html>
